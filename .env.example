TUDUDI_USER_EMAIL=admin@example.com
TUDUDI_USER_PASSWORD=replace-with-a-long-random-password
TUDUDI_SESSION_SECRET=replace-with-openssl-rand-hex-64-output
# Optional: private-only host gate, as used by Pixel Office.
# PANEL_ACCESS_ENABLED=false
# PORT=9393
# RATE_LIMIT_AUTH_MAX=300

# Optional Terminal: hidden and unreachable unless explicitly enabled.
# TERMINAL_ENABLED=false
# TERMINAL_SOCKET=/run/tududi-terminal/ttyd.sock
# Alternative to SOCKET, only for a shared host/container network namespace:
# TERMINAL_URL=http://127.0.0.1:7681
# TERMINAL_ALLOWED_EMAILS=owner@example.com
# TERMINAL_UPLOAD_DIR=/app/terminal-uploads
# TERMINAL_UPLOAD_HOST_DIR=/srv/tududi-terminal/uploads
# TERMINAL_LABEL=Terminal
# TERMINAL_CLI=claude
